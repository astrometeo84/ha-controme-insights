{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run python scripts/shared_sync.py --other ../ha-controme-insights)",
      "Bash(uv run python scripts/shared_sync.py --other ../ha-controme-insights --diff)",
      "Bash(uv run python scripts/shared_sync.py --other ../aiocontrome)",
      "Bash(uv run python scripts/shared_sync.py --other ../aiocontrome --diff)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git tag:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
